# =========================================================
# Social Sync Pro (Broadcast) — Environment Variables
# Copy this file to .env and fill in your values
# =========================================================

# Supabase Project URL & Anon/Publishable Key
# Found in your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Base URL path (default "/" for local dev and standard hosts)
VITE_BASE_PATH=/

# Optional: LinkedIn Developer Credentials
# Found at https://developer.linkedin.com/
VITE_LINKEDIN_CLIENT_ID=
VITE_LINKEDIN_CLIENT_SECRET=

# Optional: Instagram / Meta Graph API Credentials
# Found at https://developers.facebook.com/
VITE_INSTAGRAM_APP_ID=
VITE_INSTAGRAM_ACCOUNT_ID=
